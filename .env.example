# ============================================================================
# Actually read by the code (confirmed by grepping every os.getenv/os.environ
# call in backend.py and src/ — nothing else in this file currently does anything)
# ============================================================================

# HuggingFace token — required for Pyannote speaker diarization to load
# (gated model; you must also accept the terms for pyannote/speaker-diarization-3.1
# and pyannote/segmentation-3.0 on huggingface.co with this account)
HF_TOKEN=your-huggingface-token-here

# Max upload size accepted by /api/process and /api/process-lecture
MAX_FILE_SIZE_MB=500

# LLM provider (for notes, quiz, schedule, evaluation, RAG chat)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key-here
# Optional fallback keys — if set, llm_client.py automatically rotates to the
# next one when the current key is out of credits (402), invalid (401), or
# still rate-limited (429) after the existing retry-with-backoff gives up on
# it. Handy for running multiple free-tier accounts. Leave unset for a
# single-key setup; supports up to OPENROUTER_API_KEY_9.
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
# Optional model override. Default: openai/gpt-4o-mini (needs OpenRouter credits).
# To run WITHOUT credits, use a free model, e.g.:
#   OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=
# Optional: override the API base (defaults to OpenRouter). Any OpenAI-compatible
# endpoint works (e.g. NVIDIA NIM, a local server, etc.)
OPENROUTER_BASE_URL=
# Optional: sent as the HTTP-Referer header on OpenRouter requests (attribution only)
APP_URL=

# Optional: offload the audio pipeline (DeepFilterNet3/MetricGAN+/diarization/
# Whisper) to a free Kaggle GPU instead of running it locally on CPU. Missing
# -> pipeline runs locally exactly as before; set but unreachable -> backend
# automatically falls back to local CPU processing per-request, doesn't crash.
# See gpu_tunnel/README.md for the one-time Kaggle setup.
GPU_TUNNEL_URL=
GPU_TUNNEL_TOKEN=

# ============================================================================
# NOT currently read anywhere in the code — kept as documentation of intent /
# for whoever wires these up later. Setting these today has NO effect:
#   - API_HOST / API_PORT: backend.py hard-codes host="0.0.0.0", port=8000 in
#     its uvicorn.run() call.
#   - API_KEY: no route checks this. Every endpoint is currently unauthenticated —
#     see AUDIT_REPORT.md. Do not rely on this for any kind of access control.
#   - MODEL_CACHE_DIR / DEFAULT_WHISPER_MODEL: model paths and the default
#     Whisper size are hard-coded / passed per-request instead.
#   - ENABLE_GPU: nothing reads this flag — every processor (DeepFilterNet,
#     diarization, MetricGAN+, faster-whisper) auto-detects cuda vs cpu on
#     its own instead. Use GPU_TUNNEL_URL above for actual GPU offload if
#     your machine itself has no GPU.
#   - MAX_WORKERS / ENABLE_DIARIZATION / ENABLE_CACHING / ENABLE_METRICS:
#     the real equivalents live in config.yaml (diarization.enabled,
#     cache.enabled) or are inferred from whether prometheus_client is
#     installed (metrics) — none of these env vars are consulted.
#   - REDIS_URL: docker-compose.yml provisions a redis container, but nothing
#     in backend.py or src/ imports redis. The actual cache (src/cache_manager.py)
#     is a plain local-filesystem cache. Either wire this up for real or drop
#     the redis service from docker-compose.yml.
# ============================================================================
# ENV=development
# DEBUG=True
# API_HOST=0.0.0.0
# API_PORT=8000
# API_KEY=your-secret-api-key-change-in-production
# MODEL_CACHE_DIR=./models
# DEFAULT_WHISPER_MODEL=base
# ENABLE_GPU=True
# MAX_WORKERS=4
# ENABLE_DIARIZATION=True
# REDIS_URL=redis://localhost:6379/0
# ENABLE_CACHING=False
# ENABLE_METRICS=True
# LOG_LEVEL=INFO
